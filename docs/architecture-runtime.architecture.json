  "cards": [
    {
      "dot": "rose",
      "title": "4-Tier Authorization & Auth",
      "items": [
        "Better Auth session and RBAC guards (requireAuth, requireRole) protect mutating endpoints",
        "Resource ownership asserts user identity and DRAFT/PUBLISHED lifecycle state constraints"
      ]
    },
    {
      "dot": "amber",
      "title": "Concurrency & Transactions",
      "items": [
        "Parent Course Row Locking (SELECT ... FOR UPDATE) serializes curriculum mutations",
        "Two-Phase Reordering (-1 - i) and P2002 retry handlers prevent unique key collisions"
      ]
    },
    {
      "dot": "emerald",
      "title": "Architecture & Quality Rules",
      "items": [
        "Strict downward flow: UI calls Actions, Services hold logic, Repositories query database",
        "Sanitized Markdown reader, sandboxed 16:9 media player, and Sentry runtime telemetry"
      ]
    }
  ]
