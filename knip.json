{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "prettier": {
    "config": ["prettier.config.mjs"]
  },
  "eslint": {
    "config": ["eslint.config.mjs"]
  },
  "typescript": {
    "config": ["tsconfig.json"]
  },
  "postcss": {
    "config": ["postcss.config.{mjs,js}"]
  },
  "entry": ["src/actions/**/*.ts", "src/lib/**/*.ts"],
  "ignore": [
    "src/components/ui/*",
    "prisma/schema.prisma",
    "src/repositories/*.ts",
    "src/services/*.ts",
    ".agents/**"
  ],
  "ignoreDependencies": ["ts-node", "clsx", "tailwind-merge", "morphicons"]
}
