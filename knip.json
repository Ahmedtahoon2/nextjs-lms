{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "prettier": {
    "config": ["prettier.config.js"]
  },
  "eslint": {
    "config": ["eslint.config.mjs"]
  },
  "typescript": {
    "config": ["tsconfig.json"]
  },
  "postcss": {
    "config": ["postcss.config.{mjs,js}"]
  },
  "entry": ["src/actions/**/*.ts", "src/lib/**/*.ts"],
  "ignore": [
    "src/components/ui/*",
    "prisma/schema.prisma",
    "src/repositories/*.ts",
    "src/services/*.ts"
  ],
  "ignoreDependencies": [
    "@prisma/adapter-pg",
    "react-hook-form",
    "ts-node",
    "tsx"
  ]
}
