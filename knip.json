{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "prettier": {
    "config": ["prettier.config.js"]
  },
  "eslint": {
    "config": ["eslint.config.mjs"]
  },
  "typescript": {
    "config": ["tsconfig.json"]
  },
  "postcss": {
    "config": ["postcss.config.{mjs,js}"]
  },
  "ignore": [
    "src/components/ui/*",
    "prisma/schema.prisma",
    "src/lib/db.ts",
    "src/repositories/*.ts",
    "src/services/*.ts",
    "src/lib/env.ts"
  ],
  "ignoreDependencies": [
    "@neondatabase/serverless",
    "@prisma/adapter-neon",
    "@prisma/adapter-pg",
    "@prisma/client",
    "better-auth",
    "react-hook-form",
    "@t3-oss/env-nextjs",
    "pg",
    "@types/pg",
    "ws",
    "@types/ws"
  ]
}
